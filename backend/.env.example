# ==============================================================================
# sBLOOM Affiliate Portal - Backend Configuration
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="sBLOOM Affiliate Portal API"
API_V1_STR=/api/v1
VERSION=1.0.0

# Server Binding
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Strict CORS: Local frontend development origins only
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage Architecture: In-Memory Demo Mode
# Note: Database integration (Supabase) is deferred to Phase 2.
STORAGE_MODE=in_memory_temporary
DATABASE_CONNECTED=false
